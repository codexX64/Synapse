{
  "$schema": "https://raw.githubusercontent.com/CodexX64/hub-registry/main/schema/hub-extension.v1.json",
  "manifestVersion": 1,
  "id": "synapse",
  "name": "SYNAPSE",
  "version": "2.0.1",
  "description": "La mémoire et l'apprentissage de l'assistant : ce qui a été dit, ce qui a été corrigé, et ce qu'il a compris de son utilisateur.",
  "icon": "brain",
  "repository": "https://github.com/CodexX64/synapse",
  "license": "MIT",
  "minHubVersion": "0.9.0",
  "install": {
    "type": "compose",
    "compose": "deploy/compose.hub.yml",
    "remote": {
      "supported": true,
      "label": "Adresse de SYNAPSE",
      "placeholder": "http://192.0.2.30:8140",
      "defaultPort": 8140,
      "setupHelp": "Pour une mémoire déjà en service ailleurs : poser HUB_TOKEN_SEED dans son environnement (16 caractères au moins), redémarrer, puis coller ce jeton ici."
    },
    "healthcheck": {
      "type": "http",
      "path": "/healthz",
      "expect": 200,
      "timeout": "5s"
    },
    "arch": [
      "amd64",
      "arm64"
    ],
    "resources": {
      "ramMb": 512,
      "cpu": 1.0,
      "diskMb": 2048
    },
    "ports": [
      {
        "name": "http",
        "container": 8140,
        "protocol": "http",
        "expose": "proxy"
      }
    ],
    "volumes": [
      {
        "name": "data",
        "path": "/data"
      }
    ]
  },
  "config": [
    {
      "key": "IMAGE_TAG",
      "label": "Version de l'image",
      "type": "string",
      "default": "2.0.1",
      "advanced": true,
      "help": "Étiquette de l'image synapse publiée sur ghcr.io : une version précise, jamais « latest »."
    },
    {
      "key": "HUB_TOKEN",
      "label": "Jeton de service",
      "type": "secret",
      "generate": "random:32",
      "help": "Créé par le Hub à l'installation. SYNAPSE le reconnaît au démarrage : aucune commande à taper."
    },
    {
      "key": "ADMIN_TOKEN",
      "label": "Jeton d'administration des comptes",
      "type": "secret",
      "generate": "random:32",
      "help": "Créé par le Hub, distinct du jeton de service : il ne sert qu'à gérer les comptes de SYNAPSE depuis Comptes des services."
    },
    {
      "key": "LLM_FOURNISSEUR",
      "label": "IA qui rédige les réponses",
      "type": "select",
      "default": "ollama",
      "options": [
        {
          "value": "ollama",
          "label": "Ollama (celui relié à SYNAPSE)"
        },
        {
          "value": "kimi",
          "label": "Kimi (Moonshot, par API)"
        },
        {
          "value": "openai",
          "label": "OpenAI (par API)"
        },
        {
          "value": "compatible",
          "label": "Autre API compatible OpenAI"
        }
      ],
      "help": "Réponses, titres et fiche. La recherche par vecteurs reste sur Ollama dans tous les cas. Sans clé, SYNAPSE continue avec Ollama et l'indique."
    },
    {
      "key": "LLM_CLE",
      "label": "Clé d'API de l'IA",
      "type": "secret",
      "help": "Seulement pour Kimi, OpenAI ou une autre API. Kimi : platform.moonshot.ai → API Keys."
    },
    {
      "key": "LLM_MODELE",
      "label": "Modèle de l'IA",
      "type": "string",
      "default": "",
      "help": "Vide = le modèle par défaut du fournisseur (Kimi : kimi-k2-0905-preview)."
    },
    {
      "key": "LLM_URL",
      "label": "Adresse de l'API",
      "type": "string",
      "default": "",
      "advanced": true,
      "help": "Vide = l'adresse du fournisseur choisi. À remplir pour « Autre API compatible OpenAI » (se termine par /v1)."
    },
    {
      "key": "CONSOLIDATION_INTERVAL",
      "label": "Rythme de consolidation",
      "type": "string",
      "default": "1800000",
      "advanced": true,
      "help": "Millisecondes entre deux passes de distillation des échanges en traits. 0 désactive. Un profil qui bouge à chaque phrase n'est pas un profil."
    },
    {
      "key": "LLM_APPELS_JOUR",
      "label": "Appels à l'IA distante par jour",
      "type": "number",
      "default": 500,
      "min": 1,
      "advanced": true,
      "help": "Plafond des appels à une API payante (Kimi, OpenAI…) par jour : au-delà, SYNAPSE répond sans rédiger et l'inscrit au journal. Ollama, local, n'est pas compté."
    },
    {
      "key": "SOCLE_HTTP",
      "label": "Accès sans HTTPS",
      "type": "select",
      "default": "0",
      "required": true,
      "options": [
        {
          "value": "0",
          "label": "Non — l'interface de SYNAPSE est servie en HTTPS (par Relay)"
        },
        {
          "value": "1",
          "label": "Oui — réseau de confiance, mode dégradé"
        }
      ],
      "help": "Les clés d'accès n'existent qu'en HTTPS. En mode dégradé, l'administrateur se connecte avec mot de passe et application d'authentification, et SYNAPSE l'affiche partout.",
      "advanced": true
    },
    {
      "key": "SOCLE_CLE",
      "label": "Clé maîtresse",
      "type": "secret",
      "generate": "random:32",
      "help": "Scelle les secrets TOTP des comptes et le jeton Telegram. Créée par le Hub, gardée dans son coffre, jamais sur le volume de SYNAPSE."
    },
    {
      "key": "SOCLE_CLE_ANCIENNE",
      "label": "Clé maîtresse remplacée",
      "type": "secret",
      "advanced": true,
      "help": "Pendant une rotation seulement : la clé actuelle ici, une neuve dans « Clé maîtresse », redéployer, puis vider ce champ."
    },
    {
      "key": "SOCLE_JETON_INSTALLATION",
      "label": "Jeton d'installation",
      "type": "secret",
      "advanced": true,
      "help": "Vide : SYNAPSE en tire un au premier démarrage et l'écrit dans ses journaux. Il ne sert qu'à créer le premier compte."
    },
    {
      "key": "SOCLE_PROXYS",
      "label": "Relais de confiance",
      "type": "string",
      "default": "172.16.0.0/12",
      "advanced": true,
      "help": "Plages (CIDR, séparées par des virgules) des relais autorisés à transmettre l'adresse du client et le HTTPS : au moins celle du réseau du Hub, où vit Relay. Vide : SYNAPSE se croit en HTTP derrière Relay et refuse les clés d'accès."
    },
    {
      "key": "SOCLE_ORIGINES",
      "label": "Origines supplémentaires",
      "type": "string",
      "default": "",
      "advanced": true,
      "help": "Adresses complètes acceptées en plus de celle de la page, quand un relais réécrit l'hôte."
    },
    {
      "key": "SOCLE_URL_PUBLIQUE",
      "label": "Adresse publique (courriels)",
      "type": "string",
      "default": "",
      "advanced": true,
      "help": "Ex. https://synapse.exemple. Les liens des courriels et des notifications Telegram en partent."
    },
    {
      "key": "SOCLE_SMTP_HOTE",
      "label": "Relais SMTP",
      "type": "string",
      "default": "",
      "advanced": true,
      "help": "Vide : les alertes de sécurité des comptes restent visibles dans SYNAPSE, sans courriel."
    },
    {
      "key": "SOCLE_SMTP_PORT",
      "label": "Port SMTP",
      "type": "number",
      "min": 1,
      "advanced": true,
      "help": "Vide : 465 en TLS, 587 en STARTTLS."
    },
    {
      "key": "SOCLE_SMTP_SECURITE",
      "label": "Chiffrement SMTP",
      "type": "select",
      "default": "tls",
      "advanced": true,
      "options": [
        {
          "value": "tls",
          "label": "TLS dès la connexion (465)"
        },
        {
          "value": "starttls",
          "label": "STARTTLS exigé (587)"
        }
      ]
    },
    {
      "key": "SOCLE_SMTP_UTILISATEUR",
      "label": "Identifiant SMTP",
      "type": "string",
      "default": "",
      "advanced": true
    },
    {
      "key": "SOCLE_SMTP_MOTDEPASSE",
      "label": "Mot de passe SMTP",
      "type": "secret",
      "advanced": true
    },
    {
      "key": "SOCLE_SMTP_DE",
      "label": "Adresse d'expédition",
      "type": "string",
      "default": "",
      "advanced": true
    }
  ],
  "api": {
    "baseUrl": "{{service.url}}",
    "auth": {
      "type": "bearer",
      "token": "{{service.token}}",
      "localToken": "HUB_TOKEN",
      "remoteToken": "HUB_TOKEN"
    }
  },
  "capabilities": {
    "provides": [
      "memory.ingest",
      "memory.search",
      "memory.brief",
      "memory.learn",
      "memory.correct"
    ],
    "requires": [
      "llm.embed"
    ],
    "accepts": [
      "llm.chat"
    ]
  },
  "triggers": [],
  "actions": [
    {
      "id": "memory.search",
      "name": "Chercher dans la mémoire",
      "description": "Recherche en cascade : correspondance exacte, lexical, vecteurs. S'arrête au premier niveau qui suffit.",
      "icon": "search",
      "group": "Mémoire",
      "capability": "memory.search",
      "risk": "read",
      "idempotent": true,
      "params": [
        {
          "key": "query",
          "label": "Question",
          "type": "expression",
          "required": true
        },
        {
          "key": "space",
          "label": "Espace",
          "type": "string",
          "default": "shared",
          "help": "Les espaces sont étanches : une source qui écrit dans l'un ne voit pas l'autre."
        },
        {
          "key": "limit",
          "label": "Nombre de résultats",
          "type": "number",
          "default": 6,
          "min": 1,
          "max": 30
        }
      ],
      "request": {
        "method": "GET",
        "path": "/v1/search",
        "query": {
          "q": "{{params.query}}",
          "ns": "{{params.space}}",
          "limit": "{{params.limit}}"
        }
      },
      "output": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "number"
            },
            "title": {
              "type": "string"
            },
            "snippet": {
              "type": "string"
            },
            "level": {
              "type": "string"
            },
            "score": {
              "type": "number"
            },
            "occurred_at": {
              "type": "string"
            }
          }
        }
      },
      "sample": [
        {
          "id": 412,
          "title": "Le Hub déploie en Compose",
          "snippet": "Les piles sont rendues depuis le manifeste…",
          "level": "L2",
          "score": 0.81,
          "occurred_at": "2026-03-04T09:12:00.000Z"
        }
      ]
    },
    {
      "id": "memory.ingest",
      "name": "Écrire dans la mémoire",
      "description": "Enregistre un fait. Un fait déjà connu est compté, pas dupliqué.",
      "icon": "plus",
      "group": "Mémoire",
      "capability": "memory.ingest",
      "risk": "reversible",
      "params": [
        {
          "key": "text",
          "label": "Le fait",
          "type": "expression",
          "required": true
        },
        {
          "key": "space",
          "label": "Espace",
          "type": "string",
          "default": "shared"
        },
        {
          "key": "tags",
          "label": "Étiquettes",
          "type": "string",
          "help": "Séparées par des espaces."
        },
        {
          "key": "kind",
          "label": "Nature",
          "type": "string",
          "default": "note",
          "advanced": true
        }
      ],
      "request": {
        "method": "POST",
        "path": "/v1/ingest",
        "body": {
          "ns": "{{params.space}}",
          "kind": "{{params.kind}}",
          "title": "{{params.text}}",
          "body": "{{params.text}}",
          "tags": "{{params.tags}}"
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "id": {
            "type": "number"
          },
          "duplicate": {
            "type": "boolean"
          }
        }
      },
      "sample": {
        "ok": true,
        "id": 413,
        "duplicate": false
      }
    },
    {
      "id": "brief",
      "name": "Briefing avant de répondre",
      "description": "Tout ce qu'il faut savoir en un appel : le profil de l'utilisateur, ce que ce modèle a déjà mal compris, et la mémoire pertinente.",
      "icon": "sparkle",
      "group": "Apprentissage",
      "capability": "memory.brief",
      "risk": "read",
      "idempotent": true,
      "params": [
        {
          "key": "agent",
          "label": "Modèle qui va répondre",
          "type": "expression",
          "required": true,
          "help": "Rempli par le Hub avec le nom de la connexion IA. Les faits sont communs, les leçons restent propres à chaque modèle."
        },
        {
          "key": "query",
          "label": "Question posée",
          "type": "expression",
          "required": true
        },
        {
          "key": "space",
          "label": "Espace",
          "type": "string",
          "default": "shared"
        },
        {
          "key": "budget",
          "label": "Budget de temps (ms)",
          "type": "number",
          "default": 1200,
          "advanced": true,
          "help": "Au-delà, la mémoire est absente du briefing plutôt qu'attendue."
        }
      ],
      "request": {
        "method": "POST",
        "path": "/v1/brief",
        "body": {
          "agent": "{{params.agent}}",
          "q": "{{params.query}}",
          "ns": "{{params.space}}",
          "budget": "{{params.budget}}"
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "string"
          },
          "profil": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "portee": {
                  "type": "string"
                },
                "cle": {
                  "type": "string"
                },
                "valeur": {
                  "type": "string"
                },
                "confiance": {
                  "type": "number"
                }
              }
            }
          },
          "corrections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string"
                },
                "correction": {
                  "type": "string"
                },
                "n": {
                  "type": "number"
                }
              }
            }
          },
          "memoire": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "titre": {
                  "type": "string"
                },
                "extrait": {
                  "type": "string"
                }
              }
            }
          },
          "texte": {
            "type": "string"
          },
          "tronque": {
            "type": "boolean"
          },
          "ms": {
            "type": "number"
          }
        }
      },
      "sample": {
        "agent": "qwen3-14b",
        "profil": [
          {
            "portee": "commun",
            "cle": "format_commandes",
            "valeur": "Donne les commandes groupées en un seul bloc à coller.",
            "confiance": 0.82
          }
        ],
        "corrections": [
          {
            "question": "quel modèle utiliser",
            "correction": "Ne jamais inventer un nom de modèle : lire la liste du service.",
            "n": 2
          }
        ],
        "memoire": [
          {
            "titre": "Le Hub déploie en Compose",
            "extrait": "Les piles sont rendues depuis le manifeste…"
          }
        ],
        "texte": "Ce que tu sais de ton utilisateur :\n- Donne les commandes groupées en un seul bloc à coller.",
        "tronque": false,
        "ms": 38
      }
    },
    {
      "id": "echange",
      "name": "Consigner un échange",
      "description": "La question et la réponse, telles quelles. La distillation en tirera des traits plus tard, en arrière-plan.",
      "icon": "chat",
      "group": "Apprentissage",
      "capability": "memory.learn",
      "risk": "reversible",
      "params": [
        {
          "key": "agent",
          "label": "Modèle qui a répondu",
          "type": "expression",
          "required": true,
          "help": "Rempli par le Hub avec le nom de la connexion IA. Les faits sont communs, les leçons restent propres à chaque modèle."
        },
        {
          "key": "question",
          "label": "Question",
          "type": "expression",
          "required": true
        },
        {
          "key": "reponse",
          "label": "Réponse",
          "type": "expression"
        },
        {
          "key": "space",
          "label": "Espace",
          "type": "string",
          "default": "shared"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/v1/echange",
        "body": {
          "agent": "{{params.agent}}",
          "question": "{{params.question}}",
          "reponse": "{{params.reponse}}",
          "ns": "{{params.space}}"
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "id": {
            "type": "number"
          },
          "duplicate": {
            "type": "boolean"
          }
        }
      },
      "sample": {
        "ok": true,
        "id": 414,
        "duplicate": false
      }
    },
    {
      "id": "apprendre",
      "name": "Corriger une réponse",
      "description": "Ce qui a été dit de faux et ce qu'il fallait dire. La prochaine question proche ramènera la correction avant que le modèle recommence.",
      "icon": "check",
      "group": "Apprentissage",
      "capability": "memory.correct",
      "risk": "reversible",
      "params": [
        {
          "key": "agent",
          "label": "Modèle qui s'est trompé",
          "type": "expression",
          "required": true,
          "help": "Rempli par le Hub avec le nom de la connexion IA. Les faits sont communs, les leçons restent propres à chaque modèle."
        },
        {
          "key": "question",
          "label": "Question concernée",
          "type": "expression",
          "required": true
        },
        {
          "key": "correction",
          "label": "Ce qu'il fallait dire",
          "type": "expression",
          "required": true
        },
        {
          "key": "faux",
          "label": "Ce qui a été dit",
          "type": "expression"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/v1/apprendre",
        "body": {
          "agent": "{{params.agent}}",
          "question": "{{params.question}}",
          "correction": "{{params.correction}}",
          "faux": "{{params.faux}}"
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "correction": {
            "type": "object",
            "properties": {
              "id": {
                "type": "number"
              },
              "n": {
                "type": "number"
              }
            }
          }
        }
      },
      "sample": {
        "correction": {
          "id": 7,
          "n": 2
        }
      }
    },
    {
      "id": "recall",
      "name": "Retrouver une résolution passée",
      "description": "Un incident déjà résolu qui ressemble assez à celui-ci ramène son correctif.",
      "icon": "refresh",
      "group": "Mémoire",
      "risk": "read",
      "idempotent": true,
      "params": [
        {
          "key": "signature",
          "label": "Signature",
          "type": "expression",
          "required": true
        },
        {
          "key": "service",
          "label": "Service",
          "type": "expression"
        },
        {
          "key": "host",
          "label": "Machine",
          "type": "expression"
        }
      ],
      "request": {
        "method": "POST",
        "path": "/v1/recall",
        "body": {
          "query": "{{params.signature}}",
          "context": {
            "signature": "{{params.signature}}",
            "service": "{{params.service}}",
            "host": "{{params.host}}"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "similarity": {
                  "type": "number"
                },
                "via": {
                  "type": "string"
                },
                "neuron": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "number"
                    },
                    "root_cause": {
                      "type": "string"
                    },
                    "resolution": {
                      "type": "string"
                    },
                    "service": {
                      "type": "string"
                    },
                    "host": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "took_ms": {
            "type": "number"
          },
          "threshold": {
            "type": "number"
          }
        }
      },
      "sample": {
        "results": [
          {
            "similarity": 0.91,
            "via": "L0",
            "neuron": {
              "id": 19,
              "root_cause": "Limite mémoire atteinte.",
              "resolution": "Relancer le service après avoir relevé la limite mémoire.",
              "service": "web",
              "host": "srv-1"
            }
          }
        ],
        "took_ms": 4,
        "threshold": 0.85
      }
    },
    {
      "id": "consolider",
      "name": "Distiller les échanges",
      "description": "Relit les échanges récents et en tire des traits durables. Tourne aussi toute seule en arrière-plan.",
      "icon": "sparkle",
      "group": "Apprentissage",
      "risk": "reversible",
      "params": [
        {
          "key": "agent",
          "label": "Modèle (vide = tous)",
          "type": "expression",
          "required": false,
          "help": "Laisse vide pour distiller les échanges de tous les modèles. Le Hub remplit ce champ tout seul quand c'est lui qui appelle."
        }
      ],
      "request": {
        "method": "POST",
        "path": "/v1/consolider",
        "body": {
          "agent": "{{params.agent}}"
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "lus": {
            "type": "number"
          },
          "traits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "portee": {
                  "type": "string"
                },
                "cle": {
                  "type": "string"
                },
                "etat": {
                  "type": "string"
                }
              }
            }
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "sample": {
        "agents": [
          "qwen3-14b"
        ],
        "lus": 12,
        "traits": [
          {
            "portee": "commun",
            "cle": "format_commandes",
            "etat": "confirme"
          }
        ]
      }
    }
  ],
  "probes": [
    {
      "id": "reachable",
      "name": "Joignable",
      "kind": "state",
      "request": {
        "method": "GET",
        "path": "/healthz"
      },
      "value": "$.ok",
      "states": {
        "ok": [
          true,
          "true",
          "ok"
        ]
      },
      "interval": "30s"
    },
    {
      "id": "entries",
      "name": "Entrées en mémoire",
      "kind": "gauge",
      "unit": "entrées",
      "request": {
        "method": "GET",
        "path": "/v1/stats"
      },
      "value": "$.entries",
      "interval": "5m"
    },
    {
      "id": "queue",
      "name": "Morceaux en attente de vectorisation",
      "kind": "gauge",
      "unit": "morceaux",
      "request": {
        "method": "GET",
        "path": "/v1/stats"
      },
      "value": "$.chunks.pending",
      "thresholds": {
        "warn": 2000,
        "crit": 5000
      },
      "interval": "1m"
    }
  ],
  "permissions": {
    "dockerSocket": "none",
    "privileged": false,
    "hostNetwork": false,
    "capAdd": [],
    "egress": []
  },
  "ai": {
    "exposeActions": true,
    "hints": "SYNAPSE est la mémoire du Hub, pas une base de connaissances à remplir à la main. Les échanges y arrivent tout seuls. Ce qui vaut la peine d'y écrire explicitement : une décision prise, une contrainte énoncée, une résolution d'incident. Le profil se distille, il ne se saisit pas — sauf quand l'utilisateur dit explicitement « retiens que… », auquel cas passe par l'action « Corriger une réponse » ou un trait déclaré. Les espaces sont étanches : écrire dans le mauvais espace revient à ne rien écrire."
  },
  "autoWorkflows": [
    {
      "id": "memoire-alertes",
      "name": "Garder trace des alertes",
      "when": "alerts.source",
      "steps": [
        {
          "use": "trigger:alert.new"
        },
        {
          "use": "capability:memory.ingest",
          "params": {
            "text": "Alerte {{ $json.severity }} : {{ $json.title | default($json.message) }}",
            "space": "shared",
            "tags": "alerte",
            "kind": "alert"
          }
        }
      ]
    }
  ],
  "accounts": {
    "tokenKey": "ADMIN_TOKEN",
    "roles": [
      "admin",
      "membre",
      "lecture"
    ],
    "adminRole": "admin",
    "invitation": true,
    "fields": {
      "id": "$.id",
      "name": "$.identifiant",
      "role": "$.role",
      "mfa": "$.a2f",
      "created": "$.cree",
      "lastSeen": "$.derniere"
    },
    "list": {
      "method": "GET",
      "path": "/api/compte/hub/comptes"
    },
    "create": {
      "method": "POST",
      "path": "/api/compte/hub/comptes",
      "body": {
        "identifiant": "{{params.username}}",
        "role": "{{params.role}}"
      }
    },
    "update": {
      "method": "PATCH",
      "path": "/api/compte/hub/comptes/{{params.id}}",
      "body": {
        "role": "{{params.role}}"
      }
    },
    "reset": {
      "method": "POST",
      "path": "/api/compte/hub/comptes/{{params.id}}/reinit",
      "body": {}
    },
    "remove": {
      "method": "DELETE",
      "path": "/api/compte/hub/comptes/{{params.id}}"
    }
  }
}
