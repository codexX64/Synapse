# ============================================================
# SYNAPSE — configuration
# Les secrets viennent de l'environnement, jamais du dépôt.
# Copier en .env et ajuster.
# ============================================================

# --- serveur ---
PORT=8140                      # port INTERNE au conteneur
DB_FILE=/data/synapse.db
MAX_BODY=2000000               # 2 Mo par requête
QUEUE_MAX=5000                 # au-delà, /v1/ingest renvoie 429

# --- couche sémantique (facultative) ---
# Si Ollama ne répond pas, le service démarre quand même : les niveaux 0
# et 1 de la cascade fonctionnent, /healthz indique semantic:false, et le
# niveau 2 est simplement inactif. Une panne du modèle ne doit jamais
# arrêter l'ingestion.
OLLAMA_URL=http://ollama:11434
EMBED_MODEL=nomic-embed-text
EMBED_TIMEOUT=8000
EMBED_INTERVAL=4000            # rythme du worker de vectorisation
EMBED_BATCH=8

# Modèle qui SYNTHÉTISE une réponse au niveau 3. Il ne voit que les
# extraits retrouvés, jamais la question seule : c'est ce qui l'empêche
# de répondre de mémoire plutôt que depuis la base.
ANSWER_MODEL=qwen3:8b

# --- interface ---
UI_DIR=/app/ui

# Jeton de LECTURE injecté dans la page servie. L'interface tourne dans
# un navigateur : elle ne peut pas poser d'en-tête sur son propre
# chargement. Portée `read` uniquement — quiconque ouvre la page peut
# lire, personne ne peut écrire.
# Obtenir :  docker compose exec synapse node src/cli.js source add ui --scope read
# Vide = l'interface affiche son corpus de démonstration.
UI_TOKEN=

# --- exposition ---
# Origine EXACTE, jamais "*" : le navigateur refuse le joker dès que la
# requête porte des credentials.
CORS_ORIGIN=https://app.example.com

# Origine de la page SYNAPSE, pour WebAuthn. Doit être EXACTEMENT
# l'adresse tapée dans le navigateur, schéma compris.
AUTH_ORIGIN=https://synapse.example.com

# --- sources externes (facultatif) ---
# Base d'incidents en lecture seule, montée dans le conteneur.
# Permet à /v1/answer de chercher dans des tickets existants.
# TICKETS_DB=/tickets/tickets.db

# Point d'entrée d'un agrégateur d'état en direct. Quand la mémoire ne
# suffit pas, /v1/answer le consulte pour VÉRIFIER avant de répondre.
# Lecture seule, par API.
# AGREG_URL=http://aggregator:8145

# --- apprentissage ---
# Rythme de la distillation : SYNAPSE relit les échanges consignés et en
# tire des traits durables. Long exprès — un profil qui bouge à chaque
# phrase n'est pas un profil, c'est une humeur. 0 désactive la passe de
# fond ; POST /v1/consolider reste disponible à la demande.
CONSOLIDATION_INTERVAL=1800000

# --- amorçage par le Hub ---
# Une source ne se créait qu'en ligne de commande, ce qu'un installateur
# automatique ne peut pas faire avant le premier démarrage. Ces jetons
# sont reconnus au lancement et créent les sources correspondantes.
# Idempotent : le même jeton au démarrage suivant ne recrée rien.
# Minimum 16 caractères, sinon ignoré.
# HUB_TOKEN_SEED=
# HUB_ADMIN_TOKEN_SEED=
